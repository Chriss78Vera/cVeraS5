<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cVeraS5.Views.vPersona"
             Title="Directorio">
    <ContentPage.Resources>
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#312E81" Offset="0" />
            <GradientStop Color="#4F46E5" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="#F8FAFC">
        <VerticalStackLayout Padding="20,18,20,30" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="VERA" TextColor="#4F46E5" FontSize="12" FontAttributes="Bold" CharacterSpacing="3" />
                    <Label Text="Tu directorio" TextColor="#111827" FontSize="28" FontAttributes="Bold" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#EEF2FF" StrokeThickness="0" Padding="11">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Label Text="●" TextColor="#4F46E5" FontSize="16" HorizontalTextAlignment="Center" />
                </Border>
            </Grid>

            <Border Background="{StaticResource HeroGradient}" StrokeThickness="0" Padding="20,22">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#312E81" Opacity="0.22" Radius="18" Offset="0,8" /></Border.Shadow>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="14">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="PERSONAS" TextColor="#C7D2FE" FontSize="11" FontAttributes="Bold" CharacterSpacing="2" />
                        <Label Text="Organiza tus contactos" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Guarda cada registro de forma rápida y sencilla." TextColor="#E0E7FF" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="✦" TextColor="#A5B4FC" FontSize="38" VerticalOptions="Center" />
                    <Label Grid.Row="1" Text="SQLite · Local · Seguro" TextColor="#C7D2FE" FontSize="12" />
                </Grid>
            </Border>

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16" Margin="0,2,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#CBD5E1" Opacity="0.18" Radius="12" Offset="0,4" /></Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2"><Label Text="Nuevo contacto" TextColor="#111827" FontSize="18" FontAttributes="Bold" /><Label Text="Añade una persona al directorio" TextColor="#64748B" FontSize="12" /></VerticalStackLayout>
                        <Label Grid.Column="1" Text="01" TextColor="#C7D2FE" FontSize="22" FontAttributes="Bold" />
                    </Grid>
                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Entry x:Name="txtNombre" Placeholder="Nombre completo" TextColor="#111827" PlaceholderColor="#94A3B8" ClearButtonVisibility="WhileEditing" />
                    </Border>
                    <Button x:Name="btnAgregar" Text="Guardar contacto  →" Clicked="btnAgregar_Clicked" BackgroundColor="#4F46E5" TextColor="White" CornerRadius="13" HeightRequest="48" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <VerticalStackLayout Spacing="2"><Label Text="Contactos guardados" TextColor="#111827" FontSize="20" FontAttributes="Bold" /><Label x:Name="lblCount" Text="Aún no hay registros" TextColor="#64748B" FontSize="12" /></VerticalStackLayout>
                <Button x:Name="btnMostrar" Grid.Column="1" Text="↻" Clicked="btnMostrar_Clicked" BackgroundColor="#EEF2FF" TextColor="#4F46E5" CornerRadius="15" WidthRequest="46" HeightRequest="42" FontSize="22" Padding="0" />
            </Grid>

            <Label x:Name="lblMessage" TextColor="#4F46E5" FontSize="13" />
            <CollectionView x:Name="listaPersonas" HeightRequest="300" SelectionMode="None" EmptyView="Todavía no tienes contactos.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="12" Margin="0,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                                <Border BackgroundColor="#EEF2FF" StrokeThickness="0" HeightRequest="42" WidthRequest="42" Padding="0"><Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape><Label Text="♟" TextColor="#4F46E5" FontSize="21" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1"><Label Text="{Binding Name}" TextColor="#111827" FontSize="15" FontAttributes="Bold" /><Label Text="{Binding Id, StringFormat='Contacto #{0}'}" TextColor="#94A3B8" FontSize="11" /></VerticalStackLayout>
                                <Button Grid.Column="2" Text="⋯" CommandParameter="{Binding Id}" Clicked="btnEliminar_Clicked" BackgroundColor="#FFF1F2" TextColor="#E11D48" CornerRadius="12" WidthRequest="42" HeightRequest="40" Padding="0" FontSize="20" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
